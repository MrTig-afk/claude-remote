# secrets - never gated, never negotiable
.env
.env.*
!.env.example
*.local
*.pem
*.key

# machine junk
node_modules/
venv/
.venv/
.idea/
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# local-only working material - internal tooling, never published
CLAUDE.md
START-HERE.md
RUNBOOK.md
HANDOFF.md
.claude/
.pipeline/
assets/
design/
social-media/
portfolio/
project_summary.txt
docs/internal/

# local state this tool generates at runtime lives outside the repo entirely,
# under ~/.claude/plugins/data/{plugin-id}/ (Claude Code's own plugin-data
# convention) - nothing to ignore here, see .claude/project-profile.md

# passcode hash - lives outside the repo (~/.claude/plugins/data/...) but is
# never allowed in, at any path, even by accident
passcode.json
passcode-attempts.json

# probe files the static-route tests write INTO the served directory and
# delete again in their after() hooks. Listed because a crashed or killed
# run leaves them behind, and one of them (symlink-escape.js) is a real
# symlink pointing out of agent/public/ - an artefact shaped exactly like
# the escape hatch those tests exist to prove is impossible. It must never
# be committable by accident.
agent/public/probe.txt
agent/public/.hidden.js
agent/public/symlink-escape.js
agent/public/d1/
