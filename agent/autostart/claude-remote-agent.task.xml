<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Author>{{USER_ID}}</Author>
    <Description>Starts the claude-remote Local Agent (node agent/server.js) at logon, with no console window, and restarts it if it fails. Registered by agent/autostart/register-task.ps1. Remove with: Unregister-ScheduledTask -TaskName 'Claude Remote Agent' -Confirm:$false</Description>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>{{USER_ID}}</UserId>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <UserId>{{USER_ID}}</UserId>
      <LogonType>InteractiveToken</LogonType>
      <!-- LeastPrivilege, never HighestAvailable: the agent needs no admin
           rights and elevating it would only widen what a compromise of
           this file could reach. -->
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <!-- IgnoreNew: a second logon trigger (fast user switch, RDP) must not
         start a second agent competing for the same port. -->
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <!-- Both battery settings default to true. Left at the default, the
         task would refuse to start, or would be killed, on battery -
         wrong for a machine meant to be reachable at all times. -->
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>false</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <!-- Lets the owner smoke-test with Start-ScheduledTask instead of
         waiting for a reboot. -->
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <!-- PT0S = no limit. The scheduler's own default (PT72H) would kill a
         healthy agent after three days of uptime - exactly the silent
         death this task exists to prevent. -->
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
    <!-- Three one-minute retries, then give up. A genuine crash loop (the
         port permanently taken) stops thrashing after three minutes
         instead of retrying forever; raise the count if a real incident
         ever exhausts it. -->
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>{{WSCRIPT}}</Command>
      <!-- //B is batch mode and it is load-bearing, not tidiness. Without it,
           wscript.exe given a missing or moved script pops a MODAL dialog on
           a desktop nobody is looking at and never exits. The task would then
           sit forever in the running state, write nothing to the log, and
           report LastTaskResult 267009 - the same code that means "healthy" -
           while the agent is dead. Batch mode suppresses the dialog, exits
           nonzero, and lets the restart policy actually see the failure. -->
      <Arguments>//B "{{SHIM}}"</Arguments>
      <WorkingDirectory>{{AGENT_DIR}}</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
